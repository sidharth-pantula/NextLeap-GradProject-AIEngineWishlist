# Groq API for LLM Relevance Classification, Extraction & RAG Synthesis
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API v3 for Video and Comment Ingestion
YOUTUBE_API_KEY=your_youtube_api_key_here

# Serper Google Search API for Public Web Forum & Discussion Discovery
SERPER_API_KEY=your_serper_api_key_here

# Optional: Reddit API Credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=WishlistDiscoveryEngine/1.0

# Optional: Hugging Face Token (if accessing gated datasets)
HF_TOKEN=your_huggingface_token_here
